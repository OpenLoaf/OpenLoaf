model ChatSession {
  id           String        @id
  title        String        @default("新对话") /// @zod.min(1)
  isUserRename Boolean       @default(false)
  isPin        Boolean       @default(false)
  errorMessage String? /// Error message for last failed request.
  sessionPreface String? /// Session preface text for chat history and model context.
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projectId    String? /// Project id.
  boardId      String? /// Board id.
  cliId        String? /// CLI thread id formatted as {cliType}_{threadId}.
  deletedAt    DateTime? /// @zod.optional()
  messageCount Int           @default(0)
  hasAssets    Boolean       @default(false) /// 当前会话是否存在 asset/ 资源；由写入端同步 + 读取端自愈。

  kind             String? /// Session 来源：null=普通 AI chat，"wechat"=微信外部消息通道
  wechatAccountId  String? /// 当 kind="wechat" 时指向 WeChatAccount.id
  wechatPeerId     String? /// 当 kind="wechat" 时对方 user_id（私聊）或 group_id（群）

  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([isPin, updatedAt])
  @@index([projectId])
  @@index([projectId, deletedAt, createdAt])
  @@index([kind, wechatAccountId])
  @@unique([cliId])
  @@unique([kind, wechatAccountId, wechatPeerId])
}
